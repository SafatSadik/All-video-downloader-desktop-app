{
  "manifest_version": 3,
  "name": "All Video Downloader Extension",
  "version": "1.0",
  "description": "Always-on download button for any video. Click it to send the link to the All Video Downloader app, or press Ctrl+D for instant quick download.",
  
  "permissions": ["scripting"],
  "host_permissions": ["http://localhost:3000/*"],

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "action": {
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
